# Copia este archivo a .env y rellena la llave.
# Sin OPENAI_API_KEY el sistema no genera guiones: no hay contenido preparado.

# Obligatoria. Se obtiene en platform.openai.com → API keys
OPENAI_API_KEY=

# Opcional. Si la pones, la investigación busca competencia real en la web
# con fuentes citables. Si no, el análisis se declara no disponible.
GEMINI_API_KEY=

# Modelos. Cambia solo si tu cuenta no tiene acceso a los de por defecto.
STORIDEX_MODEL_WRITE=gpt-4o
STORIDEX_MODEL_MID=gpt-4o-mini
STORIDEX_MODEL_RESEARCH=gemini-3.8-flash
STORIDEX_RESEARCH_ENABLED=true

# Techo de gasto por generación completa, en dólares.
STORIDEX_MAX_COST_USD=0.10
STORIDEX_MAX_OUTPUT_TOKENS=2400

# Solo para ejecutar las pruebas automáticas. Déjalo en false para uso real.
STORIDEX_DRY_RUN=false

# Compatibilidad con el acceso compartido de evaluación de Streamlit ya existente.
# En Community Cloud se puede definir también en st.secrets. No afecta a Sites.
STORIDEX_CLAVE=
STORIDEX_TOPE_SESION=5

# Servicios opcionales del SERVIDOR. Las conexiones personales de Codex no se copian.
# Sin estas claves, el flujo sigue y muestra «Pendiente de activación».
FIRECRAWL_API_KEY=
# Clave MCP de solo lectura de https://app.vidiq.com/account/settings/mcp
VIDIQ_API_KEY=
ELEVENLABS_API_KEY=
# Identificador de una voz disponible en tu cuenta, sin clonación automática.
ELEVENLABS_VOICE_ID=
# Token de una integración propia de Canva, con design:content:write.
# Tiene caducidad: debe renovarse por el administrador de esa integración.
CANVA_ACCESS_TOKEN=
