{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tc_in": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "tc_out": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "funcion": {
            "enum": [
              "hook",
              "planteamiento",
              "conflicto",
              "giro",
              "desenlace",
              "cta",
              "cierre"
            ]
          },
          "descripcion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "cuarta_pared": {
            "enum": [
              "directa",
              "indirecta",
              "indirecta_con_tag"
            ]
          }
        },
        "required": [
          "tc_in",
          "tc_out",
          "funcion",
          "descripcion",
          "cuarta_pared"
        ]
      },
      "minItems": 2
    }
  },
  "required": [
    "beats"
  ]
}
